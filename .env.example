# WhyDown Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost/whydown
DATABASE_POOL_SIZE=5
DATABASE_TIMEOUT=30

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=8080
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production
ADMIN_PASSWORD=admin

# Scheduler token for /run-checks (at least 16 characters)
CRON_SECRET=

# Alerts
# Leave the Telegram values empty to switch the alerts off: the checks keep
# running, only the messages are skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_ENABLED=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password

# Rate limits
MAX_SITES=20
MAX_SITES_PER_HOUR=60
RESPONSE_SIZE_LIMIT=1048576
REDIRECTS_FOLLOWED=5
PER_SITE_TIMEOUT=10

# Network timeouts (seconds)
DNS_TIMEOUT=5
CONNECT_TIMEOUT=8
TLS_TIMEOUT=10
READ_TIMEOUT=15
TOTAL_TIMEOUT=60

# Site thresholds
SLOW_THRESHOLD_MS=5000
CERT_EXPIRY_WARNING_DAYS=7
INCIDENT_THRESHOLD=3

# Certificate-expiry warning tiers, in days, separated by commas.
# One warning is sent per tier when the remaining days drop to or below it.
CERT_ALERT_DAYS=14,7,3